body bin
plane XY
ngon 0.36 10
bin: extrude 0.45 scale=1.2222
color #788296
body paper
if full==1 paper_a: blob 0,0,0.5 r=0.1,0.1,0.09 mode=shell segments=12
if full==1 paper_b: blob 0.08,-0.06,0.55 r=0.1,0.1,0.09 mode=shell segments=12
if full==1 paper_c: blob -0.07,-0.05,0.6 r=0.1,0.1,0.09 mode=shell segments=12
if full==1 color #f5f5eb part=paper_a gloss=0.6
if full==1 color #f5f5eb part=paper_b gloss=0.6
if full==1 color #f5f5eb part=paper_c gloss=0.6
