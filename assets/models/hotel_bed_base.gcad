body frame
plane XY
rect 1.5 2.1
frame: extrude 0.352
color #fac850
body frame_top
plane XY offset=0.352
rect 1.5 2.1
frame_top: extrude 0.048
color #ffdc58
body sheet
plane XY offset=0.4
rect 1.45 1.85 at=0,-0.1
sheet: extrude 0.176
color #96b4e6
body sheet_top
plane XY offset=0.576
rect 1.45 1.85 at=0,-0.1
sheet_top: extrude 0.024
color #9ebdf1
body headboard
plane XY
rect 1.6 0.15 at=0,1
headboard: extrude 1+0.3*fancy
color #fac850
body pillows
pillow_l: blob 0.35,0.65,0.67 r=0.3,0.2,0.1 mode=shell segments=16
pillow_r: blob -0.35,0.65,0.67 r=0.3,0.2,0.1 mode=shell segments=16
if fancy==1 crown: blob 0,1,1.3 r=0.18,0.1,0.18 mode=shell segments=16
color #ffffff part=pillow_l gloss=0.6
color #ffffff part=pillow_r gloss=0.6
if fancy==1 color #ffcd3c part=crown gloss=0.6
