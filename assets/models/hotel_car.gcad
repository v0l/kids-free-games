body body
plane XY offset=0.15
rect 1.4 2.4
body: extrude 0.396
color #f05050
body body_top
plane XY offset=0.546
rect 1.4 2.4
body_top: extrude 0.054
color #ff5858
body glass
plane XY offset=0.6
rect 1.2 1.3 at=0,-0.1
glass: extrude 0.352
color #b4dcfa
body roof
plane XY offset=0.952
rect 1.2 1.3 at=0,-0.1
roof: extrude 0.048
color #f05050
body wheels
wheel_a: blob -0.6,0.8,0.18 r=0.12,0.18,0.18 mode=shell segments=16
wheel_b: blob 0.6,0.8,0.18 r=0.12,0.18,0.18 mode=shell segments=16
wheel_c: blob -0.6,-0.8,0.18 r=0.12,0.18,0.18 mode=shell segments=16
wheel_d: blob 0.6,-0.8,0.18 r=0.12,0.18,0.18 mode=shell segments=16
color #282832 part=wheel_a gloss=0.6
color #282832 part=wheel_b gloss=0.6
color #282832 part=wheel_c gloss=0.6
color #282832 part=wheel_d gloss=0.6
