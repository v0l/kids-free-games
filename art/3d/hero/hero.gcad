hips: blob 0,0,10.5 r=4.4,3.4,3.2
torso: blob 0,0,14.8 r=4.8,3.6,4.4 blend=2
hood: blob 0,2.4,18.4 r=4,2,2 blend=1.5
head: blob 0,-0.5,23.5 r=7,6.5,6.4 blend=1.5
hair: blob 0,2.2,25 r=6.6,5,4.4 blend=1
cap: blob 0,0.8,27.2 r=7.3,6.9,4.2 blend=0.6
brim: blob 0,-6.4,26.6 r=4.4,3.4,0.7 blend=0.6
ear_l: blob 6.9,-0.2,22.8 r=1,0.8,1.5 blend=0.5
mirror x of=ear_l
nose: blob 0,-7,21.4 r=0.9,0.7,0.8 blend=0.4
arm_l: limb 5,0,17.6 6.7,0,13.4 7,-0.8,9.8 r=2,1.7,1.4 blend=1.4
mirror x of=arm_l
hand_l: blob 7.1,-1,8.4 r=1.6,1.5,1.6 blend=0.8
mirror x of=hand_l
leg_l: limb 2.7,0,10 2.7,0,5.6 2.7,0,2.6 r=2.3,2,1.8 blend=1.2
mirror x of=leg_l
shoe_l: blob 2.7,-1.4,1.3 r=2.3,3.6,1.6 blend=0.8
mirror x of=shoe_l
sole_l: blob 2.7,-1.4,0.5 r=2.4,3.7,0.6 blend=0.2
mirror x of=sole_l
eye_l: blob 2.5,-6.3,23 r=1.5,0.9,1.9 mode=shell
mirror x of=eye_l
pupil_l: blob 2.5,-7.0,22.9 r=1,0.5,1.4 mode=shell
mirror x of=pupil_l
shine_l: blob 2.9,-7.4,23.6 r=0.4,0.3,0.45 mode=shell
mirror x of=shine_l
remesh 0.3
cheeks: select sphere=4.3,-5.2,20.8 r=1.4 mirror=x falloff=1.5
inflate 0.25
mouth: select sphere=0,-6.4,20.2 r=1.2 falloff=0.4
crease -1.2,-6.6,20.4 0,-6.8,19.9 depth=0.12 width=0.25
crease 0,-6.8,19.9 1.2,-6.6,20.4 depth=0.12 width=0.25
select all
color #f2b48a part=head
color #f2b48a part=ear_l
color #f2b48a part=ear_r
color #e8968a part=nose
color #3a2216 part=hair
color #e8264a part=cap
color #e8264a part=brim
color #f6c61a part=torso
color #f6c61a part=hood
color #f6c61a part=arm_l soft=0.6
color #f6c61a part=arm_r soft=0.6
color #f2b48a part=hand_l
color #f2b48a part=hand_r
color #2f6fb8 part=hips
color #2f6fb8 part=leg_l
color #2f6fb8 part=leg_r
color #ffffff part=shoe_l
color #ffffff part=shoe_r
color #e8264a part=sole_l
color #e8264a part=sole_r
color #ffffff part=eye_l gloss=0.8
color #ffffff part=eye_r gloss=0.8
color #1d1410 part=pupil_l gloss=0.8
color #1d1410 part=pupil_r gloss=0.8
color #ffffff part=shine_l gloss=0.9
color #ffffff part=shine_r gloss=0.9
smooth 2
decimate 5000
bone hips_b head=0,0,10.5 tail=0,0,13
bone chest parent=hips_b tail=0,0,19
